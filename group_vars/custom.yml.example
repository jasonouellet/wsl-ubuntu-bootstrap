---
# =========================================
# Example Custom Variables Configuration
# =========================================
# Copy this file to group_vars/custom.yml
# to customize your installation
#
# Example usage:
# ansible-playbook main.yml -i hosts -e @group_vars/custom.yml

# =========================================
# CA Certificate Configuration (Optional)
# =========================================
# If your organization uses an internal CA certificate:
# 1. Set the filename below
# 2. Place the certificate file in the playbook root directory
# ssl_ca_cert_name: "your-company-root-ca.crt"

# Disable components you do not need
# enable_dotnet: no
# enable_containers: no
# enable_k8s: yes

# Disable external repository configuration (Microsoft, Hashicorp, GitHub, NodeSource, Trivy)
# enable_external_repositories: no

# Optional k8s tools (disabled by default)
# enable_k8s_kubescape: true
# enable_k8s_falcoctl: true
# enable_k8s_cilium: true

# Customize versions
# nodejs_version: "20"
# dotnet_packages:
#   - dotnet-sdk-7.0

# Add extra Python packages
# python_packages_pip:
#   - pre-commit
#   - yamllint
#   - black
#   - pytest
#   - requests
#   - numpy

# Add extra Linux packages (shared for Debian/Ubuntu)
# common_packages_linux_common:
#   - ca-certificates
#   - curl
#   - git
#   - lsb-release
#   - apt-transport-https
#   - gnupg
#   - unzip
#   - zip
#   - jq
#   - wget
#   - htop
#   - vim
#   - tmux

# Debian-specific packages
# common_packages_linux_debian:
#   - htop

# Ubuntu-specific packages
# common_packages_linux_ubuntu:
#   - software-properties-common

# Legacy option: add packages through the combined list
# (it is merged with the common/debian/ubuntu lists)
# common_packages_linux:
#   - ca-certificates
#   - curl
#   - git
